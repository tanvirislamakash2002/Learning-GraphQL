{
  "name": "start-with-typescript",
  "private": true,
  "description": "A template for TypeScript projects with pre-configured tooling",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apollographql/rover-init-starters.git"
  },
  "homepage": "https://github.com/apollographql/rover-init-starters#readme",
  "bugs": {
    "url": "https://github.com/apollographql/rover-init-starters/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0"
  },
  "scripts": {
    "build": "npm run codegen && tsc",
    "codegen": "graphql-codegen",
    "postinstall": "npm run build",
    "start": "node dist/index.js",
    "dev": "nodemon --watch \"src/**\" --ext \"ts,json,graphql\" --exec \"npm run build && npm run start\" --ignore src/__generated__ --ignore ./src/datasources/BarAPI.ts",
    "test": "jest",
    "contract:emit": "prisma contract emit",
    "generate": "prisma contract emit",
    "prisma:generate": "prisma contract emit",
    "migrate": "prisma db update",
    "prisma:migrate": "prisma db update",
    "migration:plan": "prisma migration plan",
    "migration:apply": "prisma db migrate",
    "db:init": "prisma db init"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@apollo/subgraph": "^2.3.1",
    "@prisma/client": "^7.10.1",
    "@prisma/orm-postgres": "^8.0.0-rc.18",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "apollo-server-errors": "^3.3.1",
    "bcrypt": "^6.0.0",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.8",
    "graphql": "latest",
    "graphql-tag": "latest",
    "jsonwebtoken": "^9.0.3",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@graphql-codegen/typescript-resolvers": "^4.0.0",
    "@prisma/cli-engine": "^0.7.0",
    "@types/jest": "^29.0.3",
    "@types/node": "^22.0.0",
    "jest": "^29.0.3",
    "nodemon": "^3.0.0",
    "prisma": "^8.0.0-rc.23",
    "ts-jest": "^29.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "src"
    ],
    "globals": {
      "ts-jest": {
        "testRegext": "/__tests__/.*.test.ts",
        "verbose": true
      }
    }
  }
}
